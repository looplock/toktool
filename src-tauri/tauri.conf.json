{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toktool",
  "version": "0.1.0",
  "identifier": "app.toktool.desktop",
  "mainBinaryName": "toktool",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:21720",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Toktool",
        "width": 1080,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.workbuddy/blobs/**",
          "$HOME/.workbuddy/clipboard-images/**",
          "$HOME/.zcode/cli/image-cache/**"
        ]
      },
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'",
        "form-action": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:21720 http://localhost:21720",
        "font-src": "'self'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "headers": {
        "X-Content-Type-Options": "nosniff"
      }
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFMEU0NTc3Nzg5MjcyRjUKUldUMWNwSjRkMFVPN3RObVlwZ21pZ0RzaUhvN0txRjl4MXFVeDBpZ1BINkZFOWN2T0M1SmpNZWIK",
      "endpoints": [
        "https://github.com/looplock/toktool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
